# ---------------------------------------------------------------------------
# Backend configuration
#
# Copy this file to .env and adjust:   cp .env.example .env
# .env is gitignored; this example file is committed so anyone cloning the repo
# knows exactly which variables exist.
# ---------------------------------------------------------------------------

# "development" or "production".
# development => human-readable text logs, and internal error details are
#                included in API responses to save you a trip to the terminal.
# production  => JSON logs, and internal errors are hidden from clients.
APP_ENV=development

# Port the API listens on.
PORT=8080

# PostgreSQL connection string.
#
#   postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=disable
#
# sslmode=disable is fine for local development. Use sslmode=require against any
# real server. If your password contains @ : / or ?, percent-encode it.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crm_leads?sslmode=disable

# Browser origins allowed to call this API, comma-separated.
# The React dev server runs on a different port from the API, so every frontend
# request is cross-origin and the origin has to be listed here explicitly.
# 5173 is Vite's default dev port; 4173 is `vite preview`.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
