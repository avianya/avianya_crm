# ---------------------------------------------------------------------------
# Backend configuration
#
# Copy this file to .env and adjust:   cp .env.example .env
# .env is gitignored; this example file is committed so anyone cloning the repo
# knows exactly which variables exist.
# ---------------------------------------------------------------------------

# "development" or "production".
# development => human-readable text logs, and internal error details are
#                included in API responses to save you a trip to the terminal.
# production  => JSON logs, and internal errors are hidden from clients.
APP_ENV=development

# Port the API listens on.
PORT=8080

# PostgreSQL connection string.
#
#   postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=disable
#
# sslmode=disable is fine for local development. Use sslmode=require against any
# real server. If your password contains @ : / or ?, percent-encode it.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crm_leads?sslmode=disable

# Timezone for "today", "overdue" and report weeks (an IANA name).
# Leave it out to use the database's own setting.
APP_TIMEZONE=Asia/Kolkata

# Where the web app is opened. Used for the "open the lead" link in reminder
# emails.
APP_BASE_URL=http://localhost:5173

# The hour (0-23, in APP_TIMEZONE) from which each team member's daily summary
# email goes out: their overdue and today's follow-ups, stuck deals and leads
# going cold. Needs the SMTP settings below. Members can turn it off on the
# Team page.
DIGEST_HOUR=8

# ---------------------------------------------------------------------------
# Reminder emails (optional)
#
# Leave SMTP_HOST empty and reminders appear in the app only; the bell shows
# the email as "not set up". Nothing is ever pretended to be sent.
#
# Gmail:
#   1. Turn on 2-Step Verification for the Google account.
#   2. Create an app password: Google Account > Security > App passwords.
#   3. Fill in:
#        SMTP_HOST=smtp.gmail.com
#        SMTP_PORT=587
#        SMTP_USERNAME=you@gmail.com
#        SMTP_PASSWORD=the 16-character app password (spaces are fine)
#        SMTP_FROM=Pipeline CRM <you@gmail.com>
#   4. Restart the server, then use "Send test email" on the Team page.
#
# Port 587 uses STARTTLS and 465 uses TLS; either way the password is only
# ever sent over an encrypted connection.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ---------------------------------------------------------------------------
# Ad lead forms (optional)
#
# Leads from Meta Lead Ads (Facebook / Instagram) and Google Ads lead forms
# arrive by webhook. Meta and Google must be able to reach this server from the
# internet: deploy it, or while testing run a tunnel (ngrok, Cloudflare Tunnel)
# and put its https address here. The Integrations page shows the full webhook
# addresses to paste into Meta and Google.
# ---------------------------------------------------------------------------
PUBLIC_API_URL=

# Meta: create an app at developers.facebook.com, add the Webhooks product,
# subscribe the Page object to the "leadgen" field, and connect your Page.
#   META_APP_SECRET        App settings > Basic > App secret
#   META_VERIFY_TOKEN      any phrase you choose; type the same one into Meta
#   META_PAGE_ACCESS_TOKEN a long-lived Page access token with leads_retrieval
#   META_GRAPH_VERSION     optional, e.g. v23.0; empty uses the app's default
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=

# Google: in the lead form's settings in Google Ads, under "Lead delivery",
# choose webhook, paste the webhook address, and choose a key. Put the same key
# here.
GOOGLE_LEADS_KEY=

# ---------------------------------------------------------------------------
# Meta CAPI and integration settings (Settings > Marketing Integrations)
#
# People log in with their own email and password (see docs/AUTH.md).
# ADMIN_API_KEY is for scripts only: a request with the X-Admin-Key header and
# this key acts as an admin. At least 16 characters:   openssl rand -hex 24
# Leave it empty unless a script needs it.
#
# SECRETS_ENCRYPTION_KEY encrypts the tokens saved from the settings pages
# (AES-256-GCM). 32 random bytes as base64:   openssl rand -base64 32
# Keep it safe and do not change it: tokens saved under an old key cannot be
# read with a new one, and must be entered again.
# ---------------------------------------------------------------------------
ADMIN_API_KEY=
SECRETS_ENCRYPTION_KEY=

# Browser origins allowed to call this API, comma-separated.
# The React dev server runs on a different port from the API, so every frontend
# request is cross-origin and the origin has to be listed here explicitly.
# 5173 is Vite's default dev port; 4173 is `vite preview`.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# ---------------------------------------------------------------------------
# Google Sheets export (optional) - see docs/GOOGLE_SHEETS.md
#
# An OAuth 2.0 client of type "Web application" from Google Cloud Console.
# The client secret stays on the server: it is never logged or sent to the
# browser. The Google sign-in itself is stored sealed with
# SECRETS_ENCRYPTION_KEY, which must also be set.
# ---------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must match an "Authorized redirect URI" on the OAuth client exactly.
# Default: http://localhost:<PORT>/api/integrations/google-sheets/callback
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/api/integrations/google-sheets/callback
# Optional: "Choose from Google Drive" (Google Picker), to give the CRM one of
# your existing spreadsheets. Without these you can still create a new one.
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=
