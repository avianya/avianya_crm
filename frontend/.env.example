# ---------------------------------------------------------------------------
# Frontend configuration
#
# Copy to .env for local development:   cp .env.example .env
#
# Only variables prefixed VITE_ are exposed to the browser bundle. That prefix is
# Vite's safeguard: anything without it stays server-side and cannot be leaked
# into the shipped JavaScript. Never put a secret in a VITE_ variable.
# ---------------------------------------------------------------------------

# Base URL of the Go API, including the /api prefix.
# Must match the port the backend listens on (PORT in backend/.env), and the
# frontend's own origin must appear in the backend's CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=http://localhost:8080/api
