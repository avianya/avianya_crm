# ---------------------------------------------------------------------------
# Secrets and local configuration
#
# .env files hold connection strings and credentials and must never be
# committed. The .env.example files ARE committed, so anyone cloning the repo
# knows which variables exist.
# ---------------------------------------------------------------------------
.env
.env.local
.env.*.local
.env.bak
.env.*.bak
!.env.example

# ---------------------------------------------------------------------------
# Go
# ---------------------------------------------------------------------------
# Compiled binaries. `go build` with no -o drops one named after the directory.
/backend/server
/backend/backend
*.exe
*.test
*.out

# Test coverage output
coverage.out
coverage.html

# ---------------------------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo

# npm/yarn/pnpm debug output
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
